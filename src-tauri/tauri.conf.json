{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fairy Comic Library",
  "version": "0.4.0",
  "identifier": "com.fairycomiclibrary.application",
  "build": {
    "beforeDevCommand": "npm run build:avifenc && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fairy Comic Library",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "externalBin": ["binaries/brave-comic-viewer", "binaries/avifenc"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
